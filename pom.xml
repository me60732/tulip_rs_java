<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.me60732</groupId>
  <artifactId>tulip-rs-java</artifactId>
  <version>0.2.10</version>
  <packaging>jar</packaging>

  <name>tulip-rs-java</name>
  <description>
    Java bindings (Panama FFM) for the TulipRS technical-indicator library:
    95 indicators with SIMD batch modes, stateful streaming, and serialization.
    Zero third-party dependencies — the FFM API ships with the JDK.
  </description>
  <url>https://github.com/me60732/tulip_rs_java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>me60732</id>
      <name>me60732</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/me60732/tulip_rs_java.git</connection>
    <developerConnection>scm:git:git@github.com:me60732/tulip_rs_java.git</developerConnection>
    <url>https://github.com/me60732/tulip_rs_java</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Reproducible builds: Central validates checksums; pin the timestamp.
         Bump alongside <version> on each release. -->
    <project.build.outputTimestamp>2026-09-24T00:00:00Z</project.build.outputTimestamp>
    <!-- The FFM API (java.lang.foreign) is final from JDK 22. -->
    <maven.compiler.release>22</maven.compiler.release>
  </properties>

  <build>
    <!-- The repo layout is src/ for the library (examples/ and bench/ are
         intentionally outside the artifact). -->
    <sourceDirectory>src</sourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.tuliprs</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <!-- Central requires a -sources.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Central requires a -javadoc.jar; strict doclint so broken links fail the build -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <quiet>true</quiet>
          <doclint>all,-missing</doclint>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Maven Central publishing. Trusted publishing (GitHub Actions OIDC):
           this plugin exchanges the runner's OIDC token for an upload token —
           no server credentials in settings.xml and no GPG signing required.
           Keep publishingServerId=central in sync with the portal namespace. -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.11.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>true</autoPublish>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ==================== consumer: platform natives ====================
         When this pom is consumed as a dependency, exactly one of these
         profiles activates on the consumer's OS/arch and pulls the matching
         classifier jar containing the portable-baseline cdylib (x86-64-v3 /
         aarch64). The project's OWN builds (CI, release) pass
         -Dtulip.natives.skip=true so they never resolve their own
         classifiers mid-build; the published pom keeps the profiles, so
         consumers get the native automatically. -->
    <profile>
      <id>native-linux-amd64</id>
      <activation>
        <os><family>unix</family><name>linux</name><arch>amd64</arch></os>
        <property><name>!tulip.natives.skip</name></property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>${project.artifactId}</artifactId>
          <version>${project.version}</version>
          <classifier>linux-amd64</classifier>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>native-linux-arm64</id>
      <activation>
        <os><family>unix</family><name>linux</name><arch>aarch64</arch></os>
        <property><name>!tulip.natives.skip</name></property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>${project.artifactId}</artifactId>
          <version>${project.version}</version>
          <classifier>linux-arm64</classifier>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>native-darwin-amd64</id>
      <activation>
        <os><family>mac</family><arch>x86_64</arch></os>
        <property><name>!tulip.natives.skip</name></property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>${project.artifactId}</artifactId>
          <version>${project.version}</version>
          <classifier>darwin-amd64</classifier>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>native-darwin-arm64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
        <property><name>!tulip.natives.skip</name></property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>${project.artifactId}</artifactId>
          <version>${project.version}</version>
          <classifier>darwin-arm64</classifier>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>native-windows-amd64</id>
      <activation>
        <os><family>windows</family><arch>amd64</arch></os>
        <property><name>!tulip.natives.skip</name></property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${project.groupId}</groupId>
          <artifactId>${project.artifactId}</artifactId>
          <version>${project.version}</version>
          <classifier>windows-amd64</classifier>
          <scope>compile</scope>
        </dependency>
      </dependencies>
    </profile>

    <!-- Release-time only: attach the classifier jars the release workflow
         built into target/natives/ from the matching tulip_rs_ffi release.
         windows-amd64 ships the standalone DLL (crt-static: no mingw runtime
         DLLs needed); ffi releases also carry a .a for the Go binding, which
         the packaging step ignores. -->
    <profile>
      <id>ci-natives</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>attach-native-classifiers</id>
                <phase>package</phase>
                <goals><goal>attach-artifact</goal></goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <type>jar</type><classifier>linux-amd64</classifier>
                      <file>target/natives/${project.artifactId}-${project.version}-linux-amd64.jar</file>
                    </artifact>
                    <artifact>
                      <type>jar</type><classifier>linux-arm64</classifier>
                      <file>target/natives/${project.artifactId}-${project.version}-linux-arm64.jar</file>
                    </artifact>
                    <artifact>
                      <type>jar</type><classifier>darwin-amd64</classifier>
                      <file>target/natives/${project.artifactId}-${project.version}-darwin-amd64.jar</file>
                    </artifact>
                    <artifact>
                      <type>jar</type><classifier>darwin-arm64</classifier>
                      <file>target/natives/${project.artifactId}-${project.version}-darwin-arm64.jar</file>
                    </artifact>
                    <artifact>
                      <type>jar</type><classifier>windows-amd64</classifier>
                      <file>target/natives/${project.artifactId}-${project.version}-windows-amd64.jar</file>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Signing profile used only at release time (mvn deploy -Prelease).
         CI supplies the passphrase via ~/.m2/settings.xml server
         "gpg.passphrase" (from the GPG_PASSPHRASE repo secret); the public key
         899BB7F516638DD6 must be registered on keys.openpgp.org so Central can
         verify the detached signatures. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <keyname>287D9C78DB2F314848ACFECA899BB7F516638DD6</keyname>
                  <passphraseServerId>gpg.passphrase</passphraseServerId>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
